<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 XiaomiSleep"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小米手环 9 (NFC) 极简入睡声音暂停伴侣"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工作状态"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● 监听状态：已就绪"
                    android:textColor="@color/green_status"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvMediaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● 媒体高级控制：检查中..."
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="授权通知使用权（增强暂停兼容性）"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 设置卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="助眠体验配置"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_main" />

                <!-- 原生手环勿扰联动（免第三方App） -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDndSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="手环入睡勿扰同步暂停 (官方推荐)"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手环检测到入睡后会自动开启手环勿扰，同步到手机后自动淡出暂停。100% 兼容小米运动健康与手环全功能，无需任何第三方App！"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginBottom="10dp" />

                <!-- 音量淡出开关 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFadeOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="入睡后音量平滑淡出 (推荐)"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="检测到入睡后在 15 秒内渐变降至静音再暂停，避免声音骤停把人惊醒。"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginBottom="10dp" />

                <!-- 床头静止辅助 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBedsideMonitor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="床头静止无感守护 (备选辅助)"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手机放置床头连续 15 分钟完全无微动且息屏时，自动触发淡出暂停。"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 测试卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="效果验证测试"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_main" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="放着音乐时可点击测试按钮验证："
                    android:textSize="12sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnTestImmediate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▶ 立即暂停当前声音" />

                <Button
                    android:id="@+id/btnTestFadeOut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⏳ 模拟 10 秒平滑淡出暂停" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 底部说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="纯本地广播接收手环入睡事件\n无任何后台常驻耗电 · 无广告 · 无网络请求"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
